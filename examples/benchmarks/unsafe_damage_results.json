{
  "schema": "unsafe_damage/v1",
  "task": "E1 - damage-based unsafe accounting: reclassify every committed unsafe hit of P1/P2/P3 into write-served, stale-read and identity-damage (with the harmless catalog residue counted separately), then bound the typed policy's zero",
  "result_kind": "RECLASSIFICATION+BOOTSTRAP",
  "reviewer_objection": "the committed unsafe predicate is the union of the three components of the typed key (effect, entity/freshness, identity), so the typed policy's zero is analytic. This document reclassifies the same hits by damage -- a mutation that did not run, a value older than a landed write, a value produced under another identity -- and splits the identity class by an empirical measure of whether the tool's output depends on identity at all.",
  "scope": "tau-bench only: the first trial of every task in the committed corpus, replayed through the P1/P2/P3 run-scope caches of unsafe_cache_baselines, plus P4 so the typed policy's zero is re-derived by the same walk rather than trusted. The hits are the committed ones; only their classification, the intervals and the bound are new.",
  "method": {
    "damage_classes": {
      "D1": "a write served from cache: the mutation never ran while the agent's belief that it did is unchanged (the committed writes_served class)",
      "D2": "a read served across a landed write to the same entity: the memo predates a write that executed and names an entity the read names, so the value is older than the database (the committed stale_reads class)",
      "D3_damaging": "a cross-tenant read on a tool whose output depends on identity: the served value is some other identity's answer",
      "D3_harmless": "a cross-tenant read on a tool whose output does not depend on identity: the served value is what the tool would have returned anyway",
      "warranted_unsafe": "D1 + D2 + D3_damaging",
      "precedence": "one class per hit, with the committed precedence writes_served > stale_reads > cross_tenant, so the four buckets partition the committed unsafe set and their sum equals the committed count",
      "why_not_analytic": "each bucket is defined by an observable damage mode, not by a key component: a missing side effect, a value older than a landed write, a payload selected by another identity. A policy could implement all three gates and still serve a stale value if its eviction index were wrong; the zero is measured here, and then bounded"
    },
    "identity_dependence": {
      "source": "examples/real_traces/tau_bench_observed.jsonl, the observation-bearing twin of the committed corpus (same 325 first-trial records, outputs truncated to 400 characters by the compactor)",
      "validation": "each observation must echo the argument that identifies its record (\"product_id\": \"<arg>\", \"order_id\": \"<arg>\", ...) or match the tool's documented return shape (bare user id or Error for the lookups, a numeric literal for calculate, an empty observation for think); rejected observations are counted per tool, never dropped silently",
      "degenerate_join_filter": "a record whose distinct (tool, arguments) calls all carry one non-empty observation is a provably broken join and is excluded from the evidence",
      "state_control": "only calls with no earlier write in their own record are used: both records are then in the initial environment state, so divergence cannot be state drift",
      "E1": "identity selection: a (tool, non-identity arguments) group with two or more distinct identity values (user_id/email) and two or more distinct observations shows the payload is selected by the identity argument",
      "E2": "tenant divergence: a (tool, all arguments) group shared by two or more tenants with two or more distinct observations shows the payload is relative to who asked",
      "verdict": "identity-dependent iff E1 or E2 fires",
      "identity_arguments": [
        "user_id",
        "email"
      ]
    },
    "denominators": {
      "calls": "admitted (cacheable) calls: every replayed call for P1-P3, reads only for P4, which refuses writes and control tools",
      "hits": "the policy's hits, the base of every share_of_hits figure",
      "share_of_hits": "class count / hits, so the four classes sum to the committed unsafe share of hits",
      "warranted_per_1000_calls": "1000 * warranted / admitted calls"
    },
    "bootstrap": {
      "cluster_unit": "task instance: one task as one or two models performed it, labelled domain#task_id; 165 instances over 4 runs",
      "clusters": 165,
      "resamples": 10000,
      "resamples_used": 10000,
      "seed": 20240601,
      "replacement": true,
      "confidence": 0.95,
      "percentiles": [
        2.5,
        97.5
      ],
      "percentile_rule": "linear interpolation on the sorted draws: h = (n-1)*p, value at floor(h) plus the fraction to the next",
      "rng": "CPython random.Random (Mersenne Twister); indices drawn with rejection on getrandbits(64), so the draws depend only on the bit stream",
      "why_instances_not_cells": "the two model runs of one task are two attempts at the same task, not two independent draws from the task population; their calls share an initial environment state and a user, so cells are dependent. Resampling instances keeps every attempt inside its cluster and makes the unit of variation the deployment's: another batch of tasks.",
      "paired": true
    },
    "exact_bound": {
      "statistic": "one-sided 95% upper limit for a count of zero",
      "formula": "1 - alpha**(1/n), alpha = 0.05 (Clopper-Pearson at k = 0)",
      "rule_of_three": "3/n, reported beside the exact limit as the familiar approximation",
      "denominators": "admitted reads (1,728), all replayed calls (2,275), served hits (466)"
    }
  },
