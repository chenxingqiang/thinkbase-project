{
    "AGENT": {
        "NAME": "DeepSeekCodingAgent",
        "VERSION": "1.0.0",
        "TYPE": "CODE_GENERATION"
    },
    "INPUT_SPECIFICATION": {
        "MODES": [
            "DIRECT_INPUT",
            "CONTEXT_INJECTION",
            "REFERENCE_INPUT"
        ],
        "TYPES": {
            "DIRECT": {
                "supported_formats": [
                    "natural_language",
                    "code",
                    "pseudocode",
                    "uml",
                    "test_cases"
                ]
            },
            "CONTEXT": {
                "sources": [
                    "CODEBASE",
                    "DOCUMENTATION",
                    "REQUIREMENTS",
                    "TEST_SPECS",
                    "PREVIOUS_CODE"
                ]
            },
            "REFERENCE": {
                "types": [
                    "FILE_PATH",
                    "GIT_REPO",
                    "API_DOCS"
                ]
            }
        },
        "VALIDATION": {
            "STRICT_MODE": true,
            "SCHEMA_VALIDATION": true,
            "TRANSFORM_STRATEGIES": [
                "CODE_FORMATTING",
                "TYPE_CHECKING",
                "LINTING"
            ]
        }
    },
    "OUTPUT_SPECIFICATION": {
        "MODES": [
            "CODE_GENERATION",
            "CODE_REVIEW",
            "TEST_GENERATION",
            "DOCUMENTATION"
        ],
        "STRATEGIES": {
            "CODE_GENERATION": {
                "options": [
                    "COMPLETE_FILE",
                    "FUNCTION",
                    "CLASS",
                    "MODULE",
                    "PATCH"
                ]
            },
            "CODE_REVIEW": {
                "options": [
                    "STYLE_CHECK",
                    "SECURITY_AUDIT",
                    "PERFORMANCE_REVIEW",
                    "TYPE_CHECK"
                ]
            },
            "TEST_GENERATION": {
                "options": [
                    "UNIT_TESTS",
                    "INTEGRATION_TESTS",
                    "E2E_TESTS",
                    "PROPERTY_TESTS"
                ]
            },
            "DOCUMENTATION": {
                "options": [
                    "DOCSTRINGS",
                    "README",
                    "API_DOCS",
                    "EXAMPLES"
                ]
            }
        },
        "TRANSFORMATION": {
            "ENABLED": true,
            "METHODS": [
                "CODE_FORMATTING",
                "IMPORT_ORGANIZATION",
                "TYPE_ANNOTATION",
                "DOCUMENTATION_GENERATION"
            ]
        }
    },
    "COLLABORATION": {
        "MODE": "TDD",
        "WORKFLOW": [
            "requirement_analysis",
            "test_design",
            "code_implementation",
            "code_review",
            "documentation",
            "refactoring"
        ],
        "COMMUNICATION_PROTOCOL": {
            "TYPE": "SEMANTIC_MESSAGE",
            "CONSTRAINTS": {
                "MAX_DEPTH": 5,
                "TIMEOUT": 60.0,
                "RETRY_STRATEGY": {
                    "MAX_RETRIES": 3,
                    "BACKOFF_FACTOR": 1.5
                }
            }
        },
        "PERFORMANCE_TRACKING": {
            "METRICS": [
                "CODE_QUALITY",
                "TEST_COVERAGE",
                "DOCUMENTATION_COMPLETENESS",
                "EXECUTION_TIME",
                "MEMORY_USAGE"
            ]
        }
    },
    "DEVELOPMENT_STANDARDS": {
        "CODE_STYLE": {
            "PYTHON": "PEP8",
            "TYPESCRIPT": "PRETTIER",
            "JAVA": "GOOGLE_STYLE"
        },
        "TESTING": {
            "COVERAGE_THRESHOLD": 80,
            "REQUIRED_TEST_TYPES": [
                "UNIT",
                "INTEGRATION"
            ]
        },
        "DOCUMENTATION": {
            "REQUIRED_SECTIONS": [
                "USAGE",
                "API",
                "EXAMPLES"
            ],
            "DOCSTRING_STYLE": "GOOGLE"
        },
        "SECURITY": {
            "REQUIRED_CHECKS": [
                "DEPENDENCY_SCAN",
                "CODE_SCANNING",
                "SECRET_DETECTION"
            ]
        }
    }
} 