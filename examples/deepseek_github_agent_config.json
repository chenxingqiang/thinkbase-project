{
    "id": "deepseek-github-agent",
    "name": "DeepSeek GitHub Agent",
    "description": "AI agent powered by DeepSeek model for GitHub projects",
    "version": "1.0.0",
    "type": "github",
    "author": "chenxingqiang",
    
    "provider": {
        "model": "deepseek-coder-33b-instruct",
        "temperature": 0.7,
        "max_tokens": 4096,
        "api_key": "",
        "api_base": "https://api.deepseek.com/v1"
    },
    
    "github": {
        "username": "chenxingqiang",
        "email": "jojoy6677@qq.com",
        "repository_url": "",
        "default_branch": "main",
        "commit_style": "conventional",
        "auto_push": false,
        "create_pr": false
    },
    
    "instructions": {
        "repository_analysis": {
            "enabled": true,
            "max_retries": 3,
            "retry_delay": 1.0
        },
        "requirement_analysis": {
            "enabled": true,
            "max_retries": 3,
            "retry_delay": 1.0
        },
        "test_design": {
            "enabled": true,
            "max_retries": 3,
            "retry_delay": 1.0,
            "framework": "pytest"
        },
        "code_generation": {
            "enabled": true,
            "max_retries": 3,
            "retry_delay": 1.0,
            "language": "python"
        },
        "code_review": {
            "enabled": true,
            "max_retries": 3,
            "retry_delay": 1.0
        },
        "git_operations": {
            "enabled": true,
            "max_retries": 3,
            "retry_delay": 1.0
        }
    },
    
    "metrics": {
        "enabled": true,
        "track_tokens": true,
        "track_latency": true,
        "track_success_rate": true,
        "track_errors": true
    }
} 