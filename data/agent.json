{
    "name": "Academic Research Assistant",
    "version": "1.0.0",
    "description": "An AI agent that assists with academic research workflows",
    "capabilities": [
        "literature_review",
        "methodology_development",
        "data_analysis",
        "paper_writing"
    ],
    "settings": {
        "academic_levels": [
            "Undergraduate",
            "Masters",
            "PhD",
            "Postdoctoral"
        ],
        "fields": [
            "Computer Science",
            "Engineering",
            "Mathematics",
            "Physics",
            "Biology",
            "Chemistry",
            "Social Sciences",
            "Humanities"
        ],
        "output_formats": {
            "pdf": {
                "enabled": true,
                "template": "academic"
            },
            "docx": {
                "enabled": true,
                "template": "academic"
            },
            "markdown": {
                "enabled": true,
                "template": "academic"
            }
        }
    }
} 