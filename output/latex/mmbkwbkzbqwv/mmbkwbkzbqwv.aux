\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Example of a simple figure with only one panel. Relative units (here \texttt  {$\backslash $textwidth}) are preferred so that the figure adapts automatically to the text width (this command is very useful in more complex figures such as Figures~\ref {F-4panels} and~\ref {F-rotate-cut}). The use of the command \texttt  {$\backslash $includegraphics} requires the inclusion of \texttt  {$\backslash $usepackage\{graphicx\}} at the beginning of the \LaTeX  \ file. }}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{F-simple}{{1}{4}{Example of a simple figure with only one panel. Relative units (here \texttt {$\backslash $textwidth}) are preferred so that the figure adapts automatically to the text width (this command is very useful in more complex figures such as Figures~\ref {F-4panels} and~\ref {F-rotate-cut}). The use of the command \texttt {$\backslash $includegraphics} requires the inclusion of \texttt {$\backslash $usepackage\{graphicx\}} at the beginning of the \LaTeX \ file}{figure.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces  A simple table. Each column is aligned by one of the letters: l: left, c: center, r: right. Using two \$s permits one to insert equation-like features (see last column). The inclusion of $\sim $ adds a blank to approximately align the numbers of the last two columns (see the \LaTeX  \ file). }}{4}{table.caption.4}\protected@file@percent }
\newlabel{T-simple}{{1}{4}{A simple table. Each column is aligned by one of the letters: l: left, c: center, r: right. Using two \$s permits one to insert equation-like features (see last column). The inclusion of $\sim $ adds a blank to approximately align the numbers of the last two columns (see the \LaTeX \ file)}{table.caption.4}{}}
