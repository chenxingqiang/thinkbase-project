\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Example of a figure with four panels (constructed with four \texttt  {.eps} files). The labels of the panels are included with \LaTeX  \ commands so that each panel can be referred to unambiguously in the text. The position of the panels is fine-tuned with the \texttt  {$\backslash $hspace} and \texttt  {$\backslash $vspace} commands. }}{5}{figure.caption.2}\protected@file@percent }
\newlabel{F-4panels}{{2}{5}{Example of a figure with four panels (constructed with four \texttt {.eps} files). The labels of the panels are included with \LaTeX \ commands so that each panel can be referred to unambiguously in the text. The position of the panels is fine-tuned with the \texttt {$\backslash $hspace} and \texttt {$\backslash $vspace} commands}{figure.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces  A more complex table with multi-columns labels. The command \texttt  {$\backslash $multicolumn\{4\}\{c\}\{Flares (GOES)\}} permits writing the title ``Flares (GOES)'' over four columns. The alignment of the decimal points is made by defining two columns separated with an inter-column replaced by a ``.'' with the command \texttt  {r@\{.\}l} (see the \LaTeX  \ file). }}{5}{table.caption.5}\protected@file@percent }
\newlabel{T-complex}{{2}{5}{A more complex table with multi-columns labels. The command \texttt {$\backslash $multicolumn\{4\}\{c\}\{Flares (GOES)\}} permits writing the title ``Flares (GOES)'' over four columns. The alignment of the decimal points is made by defining two columns separated with an inter-column replaced by a ``.'' with the command \texttt {r@\{.\}l} (see the \LaTeX \ file)}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Example of a figure with panels smaller than the original and rotated clockwise by 90$^{\circ }$ (compare with Fig.~\ref {F-4panels}). The \texttt  {clip=} command is important to include only the selected part of the figure by changing the \texttt  {BoundingBox}. The labels of the panels are included using \LaTeX  \ commands. }}{6}{figure.caption.3}\protected@file@percent }
\newlabel{F-rotate-cut}{{3}{6}{Example of a figure with panels smaller than the original and rotated clockwise by 90$^{\circ }$ (compare with Fig.~\ref {F-4panels}). The \texttt {clip=} command is important to include only the selected part of the figure by changing the \texttt {BoundingBox}. The labels of the panels are included using \LaTeX \ commands}{figure.caption.3}{}}
