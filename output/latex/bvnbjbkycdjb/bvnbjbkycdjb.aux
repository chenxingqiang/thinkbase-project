\providecommand\HyField@AuxAddToCoFields[2]{}
\providecommand\babel@aux[2]{}
\@nameuse{bbl@beforestart}
\babel@aux{english}{}
\@writefile{toc}{\contentsline {section}{\numberline {1}Section name}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}Bibliographic citations}{1}{subsection.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}Headings}{1}{subsection.1.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.2.1}Subsubsection}{1}{subsubsection.1.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.3}Figures and Tables}{1}{subsection.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces This is an example of a figure caption.}}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:1}{{1}{1}{This is an example of a figure caption}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces This is a caption on wider figure.}}{1}{figure.caption.2}\protected@file@percent }
\newlabel{fig:2}{{2}{1}{This is a caption on wider figure}{figure.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Caption}}{1}{table.caption.3}\protected@file@percent }
\newlabel{tab:1}{{1}{1}{Caption}{table.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4}Equations and maths}{2}{subsection.1.4}\protected@file@percent }
\newlabel{eq1}{{1}{2}{Equations and maths}{equation.1.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.5}Code}{2}{subsection.1.5}\protected@file@percent }
\newlabel{code}{{1}{2}{Example use of \code {Model}}{lstlisting.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {1}{\ignorespaces Example use of {Model}}}{2}{lstlisting.1}\protected@file@percent }
