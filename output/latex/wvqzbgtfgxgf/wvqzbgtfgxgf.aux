\relax 
\providecommand\hyper@newdestlabel[2]{}
\providecommand\HyField@AuxAddToFields[1]{}
\providecommand\HyField@AuxAddToCoFields[2]{}
\providecommand\babel@aux[2]{}
\@nameuse{bbl@beforestart}
\babel@aux{english}{}
\@writefile{toc}{\contentsline {section}{\numberline {1}Insert A head here}{2}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}Insert B head here}{2}{subsection.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.1.1}Insert C head here}{2}{subsubsection.1.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Equations}{2}{section.2}\protected@file@percent }
\newlabel{1.1}{{1}{2}{Equations}{equation.2.1}{}}
\newlabel{1.2}{{2}{2}{Equations}{equation.2.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Enunciations}{2}{section.3}\protected@file@percent }
\newlabel{T0.1}{{3}{2}{Enunciations}{section.3}{}}
\newlabel{C2.2}{{3}{2}{Enunciations}{section.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Figures \& Tables}{2}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Insert figure caption here}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig_sim}{{1}{2}{Insert figure caption here}{figure.caption.1}{}}
\bibcite{1}{1}
\bibcite{2}{2}
\bibcite{3}{3}
\bibcite{4}{4}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces An Example of a Table}}{3}{table.caption.2}\protected@file@percent }
\newlabel{table_example}{{1}{3}{An Example of a Table}{table.caption.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Conclusion}{3}{section.5}\protected@file@percent }
\gdef \@abspage@last{3}
