\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces This is a caption}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:fig1}{{1}{4}{This is a caption}{figure.1}{}}
\gdef \@abspage@last{4}
