\providecommand\hyper@newdestlabel[2]{}
\providecommand\HyField@AuxAddToFields[1]{}
\providecommand\HyField@AuxAddToCoFields[2]{}
\providecommand\babel@aux[2]{}
\@nameuse{bbl@beforestart}
\bibstyle{mplainnat}
\babel@aux{indonesian}{}
\citation{HararyR74}
\citation{Berge57}
\citation{Berge58}
\bibdata{refs}
\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{2}{section.1}\protected@file@percent }
\newlabel{sec:intro}{{1}{2}{Introduction}{section.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}Preliminaries}{2}{subsection.1.1}\protected@file@percent }
\newlabel{sec:pre}{{1.1}{2}{Preliminaries}{subsection.1.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}Previous Results}{2}{subsection.1.2}\protected@file@percent }
\newlabel{sec:prev-results}{{1.2}{2}{Previous Results}{subsection.1.2}{}}
\newlabel{thrm:1}{{1}{2}{Previous Results}{theorem.1}{}}
\newlabel{cor:1}{{2}{2}{Previous Results}{theorem.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces This is a table}}{2}{table.1}\protected@file@percent }
\newlabel{tbl:1}{{1}{2}{This is a table}{table.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}More Examples}{2}{section.2}\protected@file@percent }
\newlabel{sec:examples}{{2}{2}{More Examples}{section.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Acknowledgements}{2}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {A}Omitted Proof in Section~\ref {sec:examples}}{2}{appendix.A}\protected@file@percent }
\newlabel{app:1}{{A}{2}{Omitted Proof in Section~\ref {sec:examples}}{appendix.A}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces An example of a figure}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:example}{{1}{3}{An example of a figure}{figure.1}{}}
\gdef \@abspage@last{3}
