\relax 
\providecommand\hyper@newdestlabel[2]{}
\providecommand\HyField@AuxAddToFields[1]{}
\providecommand\HyField@AuxAddToCoFields[2]{}
\providecommand\babel@aux[2]{}
\@nameuse{bbl@beforestart}
\babel@aux{english}{}
\@writefile{toc}{\contentsline {section}{\numberline {1}Insert A head here}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}Insert B head here}{2}{subsection.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.1.1}Insert C head here}{2}{subsubsection.1.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Equations}{2}{section.2}\protected@file@percent }
\newlabel{eq:first}{{1}{2}{Equations}{equation.2.1}{}}
\newlabel{eq:another}{{2}{2}{Equations}{equation.2.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Figures \& Tables}{2}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Insert figure caption here}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig_sim}{{1}{3}{Insert figure caption here}{figure.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces An Example of a Table}}{3}{table.caption.3}\protected@file@percent }
\newlabel{table_example}{{1}{3}{An Example of a Table}{table.caption.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Conclusion}{3}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Funding Statement}{3}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Competing Interests}{3}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Example Appendix Section}{3}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Insert figure caption here}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig_wide}{{2}{4}{Insert figure caption here}{figure.caption.2}{}}
\gdef \@abspage@last{4}
