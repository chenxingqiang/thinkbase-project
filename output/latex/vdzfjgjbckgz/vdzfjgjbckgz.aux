\providecommand\HyField@AuxAddToFields[1]{}
\providecommand\HyField@AuxAddToCoFields[2]{}
\providecommand\babel@aux[2]{}
\@nameuse{bbl@beforestart}
\bibcite{lamport94}{Lamport(1994)}
\babel@aux{english}{}
\@writefile{toc}{\contentsline {section}{\numberline {1}Example Section}{1}{section.1}\protected@file@percent }
\newlabel{sec1}{{1}{1}{Example Section}{section.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}Example Subsection}{1}{subsection.1.1}\protected@file@percent }
\newlabel{subsec1}{{1.1}{1}{Example Subsection}{subsection.1.1}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.1.1}Mathematics}{1}{subsubsection.1.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Example Appendix Section}{1}{section.2}\protected@file@percent }
\newlabel{app1}{{2}{1}{Example Appendix Section}{section.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Table Caption}}{2}{table.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig1}{{1}{2}{Table Caption}{table.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Figure Caption}}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig1}{{1}{2}{Figure Caption}{figure.caption.2}{}}
