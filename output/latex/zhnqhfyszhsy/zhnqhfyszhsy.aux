\relax 
\providecommand\hyper@newdestlabel[2]{}
\providecommand\HyField@AuxAddToFields[1]{}
\providecommand\HyField@AuxAddToCoFields[2]{}
\providecommand\babel@aux[2]{}
\@nameuse{bbl@beforestart}
\citation{RefJ}
\bibcite{RefJ}{1}
\bibcite{RefB}{2}
\babel@aux{english}{}
\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{1}{section.1}\protected@file@percent }
\newlabel{intro}{{1}{1}{Introduction}{section.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Section title}{1}{section.2}\protected@file@percent }
\newlabel{sec:1}{{2}{1}{Section title}{section.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Subsection title}{1}{subsection.2.1}\protected@file@percent }
\newlabel{sec:2}{{2.1}{1}{Subsection title}{subsection.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Please write your figure caption here.}}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:1}{{1}{1}{Please write your figure caption here}{figure.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Please write your table caption here.}}{2}{table.caption.2}\protected@file@percent }
\newlabel{tab:1}{{1}{2}{Please write your table caption here}{table.caption.2}{}}
\gdef \@abspage@last{2}
