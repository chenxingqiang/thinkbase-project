\frametitle{Exemplo de código}

Exemplo de código em Python.

\begin{lstlisting}[language=Python,keywordstyle=\bf,stringstyle=\it]
# Fibonacci numbers module

def fib(n):    # write Fibonacci series up to n
    a, b = 0, 1
    while a < n:
        print(a, end=' ')
        a, b = b, a+b
    print()
\end{lstlisting}

